# Backend (FastAPI)
GOOGLE_MAPS_API_KEY=
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MAX_UPLOAD_BYTES=10485760
CACHE_REFRESH_SECRET=

# Solar-AI (dashboard Q&A panel) — required for POST /solar-ai/analyze
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Map agent (the AI chat panel on the Solar Detections page). Uses OPENAI_API_KEY
# and OPENAI_MODEL above unless overridden here.
AGENT_MODEL=
# Reasoning models reject function tools on /v1/chat/completions unless this is
# "none". Only change it if you point AGENT_MODEL at a model with other rules.
AGENT_REASONING_EFFORT=none
AGENT_MAX_TOOL_TURNS=8
AGENT_MAX_TOKENS_PER_TURN=2048

# Satellite scan tuning. Tiling defaults ON: a single downscaled pass loses the
# resolution solar panels need (measured on a 1600m scan: 0 arrays found without
# tiling, 35 with). Set SAM3_SAT_TILING=0 for the fast-but-blind single pass.
SAM3_SAT_TILING=1
SAM3_SAT_MAX_DIM=1024
SAM3_SAT_TILE_OVERLAP=0.22
SAM3_SAT_CONF=0.20

# Frontend (Vite — prefix with VITE_)
VITE_API_URL=/api
VITE_USE_BACKEND_CACHE=false

# CI / tests
RUN_LIVE_API_TESTS=0
